# Copy to backend runtime environment (or docker-compose overrides these)
# Database (docker-compose maps Postgres to host port 5433)
DATABASE_URL=jdbc:postgresql://localhost:5433/skillproof
DATABASE_USERNAME=skillproof
DATABASE_PASSWORD=skillproof

# Security — generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production-0123456789abcdef

# Optional local AI evaluation (Ollama-compatible endpoint).
# Leave provider=auto with nothing running to fall back to the built-in keyword grader.
AI_PROVIDER=auto
AI_BASE_URL=http://localhost:11434
AI_MODEL=llama3.2
